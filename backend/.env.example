# Supabase server-side database access
# Find the URL in Supabase: Project Settings > Data API.
SUPABASE_URL=https://YOUR_PROJECT_REFERENCE.supabase.co

# Use the secret API key (sb_secret_...) or the legacy service_role key.
# This value belongs only in the backend environment. Never use VITE_ and
# never place it in frontend source code.
SUPABASE_SECRET_KEY=replace_with_your_backend_secret_key
SUPABASE_TIMEOUT_SECONDS=20

# InfluxDB connection
INFLUX_URL=https://your-influxdb-host
INFLUX_TOKEN=replace_with_your_influxdb_token
INFLUX_ORG=replace_with_your_influxdb_org
INFLUX_BUCKET=replace_with_your_influxdb_bucket
INFLUX_PRESSURE_MEASUREMENT_BAR=PSTR_bar
INFLUX_PRESSURE_MEASUREMENT_PSI=PSTR_psi
DEFAULT_PRESSURE_UNIT=bar

# Local frontend. Replace this with the deployed frontend URL in production.
FRONTEND_ORIGIN=http://localhost:5173

# Optional RCA/LLM settings used by the existing AI features
OPENAI_API_KEY=
LLM_MODEL=

# Plant time and cycle-detection safety settings
PLANT_TIMEZONE=Asia/Kuala_Lumpur
CYCLE_STABLE_BASELINE_MINUTES=2
# Canonical bar above the observed idle centre. This is configurable so a
# plant-specific value can be supplied without changing source code.
CYCLE_IDLE_TOLERANCE_BAR=0.03
CYCLE_QUERY_PADDING_MINUTES=5
# Boundary context used only by Daily Report cycle detection. A detected cycle
# is counted only when its end time is inside the selected operational day.
DAILY_REPORT_CYCLE_LOOKBACK_MINUTES=120
CYCLE_BOUNDARY_LOOKAROUND_MINUTES=20
CYCLE_MAX_DATA_GAP_SECONDS=60
CYCLE_MAX_INACTIVE_GAP_MINUTES=15
CYCLE_MIN_ACTIVE_MINUTES=5
